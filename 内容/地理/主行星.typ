#let 大气表(区) = {
  // 两位小数,补零
  let 两位(x) = {
    let s = str(calc.round(x, digits: 2))
    let p = s.split(".")
    if p.len() == 1 { s + ".00" }
    else { p.at(0) + "." + p.at(1) + "00".slice(0, 2 - p.at(1).len()) }
  }
  // 并入分层边界:对流层顶、平流层顶
  let 边界 = (对流层顶(区) / 1000, 平流层顶高 / 1000)
  let 高度 = (..表高, ..边界).dedup().sorted()
  高度.map(hkm => {
    let h = hkm * 1000
    let 高 = if hkm in 边界 { 两位(hkm) } else { str(hkm) }
    (
      [#高],
      [#calc.round(大气温度(区, h), digits: 1)],
      [#有效(大气密度(区, h))],
      [#calc.round(大气声速(区, h))],
    )
  }).flatten()
}

